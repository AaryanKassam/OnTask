{
  "manifest_version": 3,
  "name": "OnTask",
  "version": "0.1.0",
  "description": "Works out what you're doing from your tabs, checks the guess with you, and nudges you when you've drifted off it.",
  "permissions": ["tabs", "storage", "alarms", "scripting", "idle"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "OnTask",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
